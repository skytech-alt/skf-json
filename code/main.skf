// ============================================
//   skf-json — полноценный JSON от SkyMonder
//   Парсинг, пути, слияние, поиск, валидация
// ============================================


// --------------------------------------------
//   ПАРСИНГ И СЕРИАЛИЗАЦИЯ
// --------------------------------------------

функция разобрать(текст) {
    // Парсит JSON-строку в объект SkyForge
    подключить_питон("json")
    попробовать {
        вернуть json.loads(текст)
    } поймать (ошибка) {
        бросить "Ошибка парсинга JSON: " + ошибка
    }
}

функция в_строку(данные) {
    // Сериализует объект в компактную JSON-строку
    подключить_питон("json")
    попробовать {
        вернуть json.dumps(данные, ensure_ascii=ложь)
    } поймать (ошибка) {
        бросить "Ошибка сериализации: " + ошибка
    }
}

функция красиво(данные) {
    // Сериализует с отступами (2 пробела)
    подключить_питон("json")
    попробовать {
        вернуть json.dumps(данные, ensure_ascii=ложь, indent=2)
    } поймать (ошибка) {
        бросить "Ошибка сериализации: " + ошибка
    }
}

функция красиво_с(данные, отступ) {
    // Сериализует с заданным отступом
    подключить_питон("json")
    вернуть json.dumps(данные, ensure_ascii=ложь, indent=отступ)
}

функция валидный?(текст) {
    // Проверяет, является ли строка валидным JSON
    подключить_питон("json")
    попробовать {
        json.loads(текст)
        вернуть истина
    } поймать (ошибка) {
        вернуть ложь
    }
}


// --------------------------------------------
//   ФАЙЛОВЫЕ ОПЕРАЦИИ
// --------------------------------------------

функция читать(путь) {
    // Читает JSON из файла
    подключить_питон("json")
    попробовать {
        пусть файл = open(путь, "r", encoding="utf-8")
        пусть данные = json.load(файл)
        файл.close()
        вернуть данные
    } поймать (ошибка) {
        бросить "Не удалось прочитать JSON: " + ошибка
    }
}

функция записать(путь, данные) {
    // Пишет JSON в файл компактно
    подключить_питон("json")
    попробовать {
        пусть файл = open(путь, "w", encoding="utf-8")
        json.dump(данные, файл, ensure_ascii=ложь)
        файл.close()
        вернуть истина
    } поймать (ошибка) {
        бросить "Не удалось записать JSON: " + ошибка
    }
}

функция записать_красиво(путь, данные) {
    // Пишет JSON в файл с отступами
    подключить_питон("json")
    попробовать {
        пусть файл = open(путь, "w", encoding="utf-8")
        json.dump(данные, файл, ensure_ascii=ложь, indent=2)
        файл.close()
        вернуть истина
    } поймать (ошибка) {
        бросить "Не удалось записать JSON: " + ошибка
    }
}


// --------------------------------------------
//   ЗАПРОСЫ ПО ПУТЯМ (dot-notation)
// --------------------------------------------

функция получить(данные, путь) {
    // Получает значение по пути "user.address.city"
    // Работает и с массивами: "users.0.name"
    пусть части = путь.разделить(".")
    пусть текущий = данные
    
    для (часть в части) {
        если (текущий == ничего) {
            вернуть ничего
        }
        
        // Если это список, а часть — число, берём по индексу
        если (тип(текущий) == "список" и часть.это_число?()) {
            пусть индекс = число(часть)
            если (индекс < 0 или индекс >= длина(текущий)) {
                вернуть ничего
            }
            текущий = текущий[индекс]
        } иначе если (тип(текущий) == "словарь") {
            если (текущий.содержит(часть) == ложь) {
                вернуть ничего
            }
            текущий = текущий[часть]
        } иначе {
            вернуть ничего
        }
    }
    
    вернуть текущий
}

функция установить(данные, путь, значение) {
    // Устанавливает значение по пути, создавая промежуточные объекты
    пусть части = путь.разделить(".")
    пусть текущий = данные
    
    пусть i = 0
    пока (i < длина(части) - 1) {
        пусть часть = части[i]
        
        если (текущий.содержит(часть) == ложь) {
            текущий[часть] = {}
        }
        текущий = текущий[часть]
        i = i + 1
    }
    
    текущий[части[длина(части) - 1]] = значение
    вернуть данные
}

функция удалить_путь(данные, путь) {
    // Удаляет значение по пути
    пусть части = путь.разделить(".")
    пусть текущий = данные
    
    пусть i = 0
    пока (i < длина(части) - 1) {
        пусть часть = части[i]
        если (текущий.содержит(часть) == ложь) {
            вернуть данные
        }
        текущий = текущий[часть]
        i = i + 1
    }
    
    пусть последняя = части[длина(части) - 1]
    если (текущий.содержит(последняя)) {
        текущий.удалить(последняя)
    }
    вернуть данные
}

функция существует_путь?(данные, путь) {
    // Проверяет, существует ли путь
    пусть значение = получить(данные, путь)
    вернуть значение != ничего
}


// --------------------------------------------
//   РАБОТА С КЛЮЧАМИ
// --------------------------------------------

функция ключи(данные) {
    // Возвращает список ключей словаря
    подключить_питон("builtins")
    попробовать {
        вернуть list(данные.keys())
    } поймать (ошибка) {
        бросить "Не словарь: " + ошибка
    }
}

функция значения(данные) {
    // Возвращает список значений словаря
    подключить_питон("builtins")
    попробовать {
        вернуть list(данные.values())
    } поймать (ошибка) {
        бросить "Не словарь: " + ошибка
    }
}

функция пары(данные) {
    // Возвращает список пар [ключ, значение]
    подключить_питон("builtins")
    пусть результат = []
    для (ключ, значение в данные.предметы()) {
        результат.добавить([ключ, значение])
    }
    вернуть результат
}

функция есть_ключ?(данные, ключ) {
    // Проверяет наличие ключа
    подключить_питон("builtins")
    попробовать {
        вернуть ключ in данные
    } поймать (ошибка) {
        вернуть ложь
    }
}


// --------------------------------------------
//   СЛИЯНИЕ И КОПИРОВАНИЕ
// --------------------------------------------

функция слить(данные1, данные2) {
    // Поверхностное слияние: ключи из данные2 перезаписывают данные1
    подключить_питон("builtins")
    пусть результат = {}
    для (ключ, значение в данные1.предметы()) {
        результат[ключ] = значение
    }
    для (ключ, значение в данные2.предметы()) {
        результат[ключ] = значение
    }
    вернуть результат
}

функция слить_глубоко(данные1, данные2) {
    // Глубокое слияние: вложенные словари сливаются рекурсивно
    пусть результат = копия(данные1)
    
    для (ключ, значение в данные2.предметы()) {
        если (есть_ключ?(результат, ключ) и тип(результат[ключ]) == "словарь" и тип(значение) == "словарь") {
            результат[ключ] = слить_глубоко(результат[ключ], значение)
        } иначе {
            результат[ключ] = значение
        }
    }
    
    вернуть результат
}

функция копия(данные) {
    // Глубокая копия объекта (через JSON-сериализацию)
    подключить_питон("json")
    вернуть json.loads(json.dumps(данные))
}


// --------------------------------------------
//   ПОИСК ПО ДЕРЕВУ
// --------------------------------------------

функция найти_ключ(данные, ключ) {
    // Ищет все значения по имени ключа на любом уровне вложенности
    пусть результат = []
    
    функция обход(узел) {
        если (тип(узел) == "словарь") {
            для (к, з в узел.предметы()) {
                если (к == ключ) {
                    результат.добавить(з)
                }
                обход(з)
            }
        } иначе если (тип(узел) == "список") {
            для (элемент в узел) {
                обход(элемент)
            }
        }
    }
    
    обход(данные)
    вернуть результат
}

функция пути_к_ключу(данные, ключ) {
    // Возвращает список путей, где встречается ключ
    пусть результат = []
    
    функция обход(узел, путь) {
        если (тип(узел) == "словарь") {
            для (к, з в узел.предметы()) {
                пусть новый_путь = путь
                если (путь == "") {
                    новый_путь = к
                } иначе {
                    новый_путь = путь + "." + к
                }
                
                если (к == ключ) {
                    результат.добавить(новый_путь)
                }
                обход(з, новый_путь)
            }
        } иначе если (тип(узел) == "список") {
            пусть i = 0
            для (элемент в узел) {
                пусть новый_путь = путь + "." + строка(i)
                обход(элемент, новый_путь)
                i = i + 1
            }
        }
    }
    
    обход(данные, "")
    вернуть результат
}


// --------------------------------------------
//   РАЗМЕРЫ И СТАТИСТИКА
// --------------------------------------------

функция длина_json(данные) {
    // Количество ключей (для словаря) или элементов (для списка)
    подключить_питон("builtins")
    попробовать {
        вернуть len(данные)
    } поймать (ошибка) {
        вернуть 0
    }
}

функция пусто?(данные) {
    // Проверяет, пустой ли объект/список/строка
    вернуть длина_json(данные) == 0
}

функция глубина(данные) {
    // Максимальная глубина вложенности
    если (тип(данные) == "словарь") {
        если (длина_json(данные) == 0) {
            вернуть 1
        }
        пусть макс = 0
        для (значение в данные.значения()) {
            пусть г = глубина(значение)
            если (г > макс) {
                макс = г
            }
        }
        вернуть макс + 1
    } иначе если (тип(данные) == "список") {
        если (длина_json(данные) == 0) {
            вернуть 1
        }
        пусть макс = 0
        для (элемент в данные) {
            пусть г = глубина(элемент)
            если (г > макс) {
                макс = г
            }
        }
        вернуть макс + 1
    } иначе {
        вернуть 1
    }
}

функция количество_ключей(данные) {
    // Общее число ключей во всём дереве (включая вложенные)
    пусть счётчик = 0
    
    функция обход(узел) {
        если (тип(узел) == "словарь") {
            счётчик = счётчик + длина_json(узел)
            для (значение в узел.значения()) {
                обход(значение)
            }
        } иначе если (тип(узел) == "список") {
            для (элемент в узел) {
                обход(элемент)
            }
        }
    }
    
    обход(данные)
    вернуть счётчик
}


// --------------------------------------------
//   СРАВНЕНИЕ
// --------------------------------------------

функция равны?(данные1, данные2) {
    // Глубокое сравнение двух JSON-объектов
    подключить_питон("json")
    пусть с1 = json.dumps(данные1, sort_keys=истина, ensure_ascii=ложь)
    пусть с2 = json.dumps(данные2, sort_keys=истина, ensure_ascii=ложь)
    вернуть с1 == с2
}

функция различия(данные1, данные2) {
    // Возвращает список путей, где значения различаются
    пусть результат = []
    
    функция обход(а, б, путь) {
        если (тип(а) != тип(б)) {
            результат.добавить({"путь": путь, "от": а, "до": б})
            вернуть
        }
        
        если (тип(а) == "словарь") {
            пусть все_ключи = {}
            для (к в а.ключи()) { все_ключи[к] = истина }
            для (к в б.ключи()) { все_ключи[к] = истина }
            
            для (к в все_ключи.ключи()) {
                пусть новый_путь = путь
                если (путь == "") {
                    новый_путь = к
                } иначе {
                    новый_путь = путь + "." + к
                }
                
                если (есть_ключ?(а, к) == ложь) {
                    результат.добавить({"путь": новый_путь, "от": ничего, "до": б[к]})
                } иначе если (есть_ключ?(б, к) == ложь) {
                    результат.добавить({"путь": новый_путь, "от": а[к], "до": ничего})
                } иначе {
                    обход(а[к], б[к], новый_путь)
                }
            }
        } иначе если (тип(а) == "список") {
            пусть макс = длина_json(а)
            если (длина_json(б) > макс) {
                макс = длина_json(б)
            }
            пусть i = 0
            пока (i < макс) {
                пусть новый_путь = путь + "." + строка(i)
                если (i >= длина_json(а)) {
                    результат.добавить({"путь": новый_путь, "от": ничего, "до": б[i]})
                } иначе если (i >= длина_json(б)) {
                    результат.добавить({"путь": новый_путь, "от": а[i], "до": ничего})
                } иначе {
                    обход(а[i], б[i], новый_путь)
                }
                i = i + 1
            }
        } иначе {
            если (а != б) {
                результат.добавить({"путь": путь, "от": а, "до": б})
            }
        }
    }
    
    обход(данные1, данные2, "")
    вернуть результат
}


// --------------------------------------------
//   ФИЛЬТРАЦИЯ И ТРАНСФОРМАЦИЯ
// --------------------------------------------

функция фильтр_ключей(данные, список_ключей) {
    // Оставляет только указанные ключи (верхний уровень)
    пусть результат = {}
    для (ключ в список_ключей) {
        если (есть_ключ?(данные, ключ)) {
            результат[ключ] = данные[ключ]
        }
    }
    вернуть результат
}

функция без_ключей(данные, список_ключей) {
    // Удаляет указанные ключи (верхний уровень)
    пусть результат = копия(данные)
    для (ключ в список_ключей) {
        если (есть_ключ?(результат, ключ)) {
            результат.удалить(ключ)
        }
    }
    вернуть результат
}

функция преобразовать_ключи(данные, функция_преобразования) {
    // Применяет функцию к каждому ключу верхнего уровня
    пусть результат = {}
    для (ключ, значение в данные.предметы()) {
        пусть новый_ключ = функция_преобразования(ключ)
        результат[новый_ключ] = значение
    }
    вернуть результат
}

функция оставить_типы(данные, тип_значения) {
    // Оставляет ключи, значения которых имеют указанный тип
    // тип_значения: "строка", "число", "словарь", "список", "булево", "ничего"
    пусть результат = {}
    для (ключ, значение в данные.предметы()) {
        если (тип(значение) == тип_значения) {
            результат[ключ] = значение
        }
    }
    вернуть результат
}


// --------------------------------------------
//   МАССИВЫ (списки)
// --------------------------------------------

функция сортировать(список) {
    // Сортирует список (числа или строки)
    подключить_питон("builtins")
    попробовать {
        вернуть sorted(список)
    } поймать (ошибка) {
        бросить "Не удалось отсортировать: " + ошибка
    }
}

функция сортировать_по(список, ключ) {
    // Сортирует список словарей по указанному ключу
    подключить_питон("builtins")
    попробовать {
        вернуть sorted(список, key=функция(элемент) { вернуть элемент[ключ] })
    } поймать (ошибка) {
        бросить "Не удалось отсортировать: " + ошибка
    }
}

функция уникальные(список) {
    // Убирает дубликаты, сохраняя порядок
    пусть результат = []
    пусть видели = {}
    для (элемент в список) {
        пусть ключ = в_строку(элемент)
        если (есть_ключ?(видели, ключ) == ложь) {
            видели[ключ] = истина
            результат.добавить(элемент)
        }
    }
    вернуть результат
}

функция взять_поля(список, поля) {
    // Из списка словарей оставляет только указанные поля
    пусть результат = []
    для (элемент в список) {
        результат.добавить(фильтр_ключей(элемент, поля))
    }
    вернуть результат
}

функция сгруппировать_по(список, ключ) {
    // Группирует список словарей по значению ключа
    пусть результат = {}
    для (элемент в список) {
        пусть значение = получить(элемент, ключ)
        пусть строка_ключа = в_строку(значение)
        если (есть_ключ?(результат, строка_ключа) == ложь) {
            результат[строка_ключа] = []
        }
        результат[строка_ключа].добавить(элемент)
    }
    вернуть результат
}

функция сумма_по(список, ключ) {
    // Суммирует значения ключа по всем элементам
    пусть сумма = 0
    для (элемент в список) {
        пусть значение = получить(элемент, ключ)
        если (значение != ничего) {
            сумма = сумма + значение
        }
    }
    вернуть сумма
}


// --------------------------------------------
//   СХЕМА (простая валидация)
// --------------------------------------------

функция проверить_схему(данные, схема) {
    // Проверяет, соответствует ли объект схеме.
    // Схема: {"поле": "тип", "другое": "тип?", "вложенное": {...}}
    // "?" в конце типа означает необязательное поле.
    пусть ошибки = []
    
    для (ключ, ожидаемый_тип в схема.предметы()) {
        пусть необязательно = ложь
        если (ожидаемый_тип.содержит("?")) {
            необязательно = истина
            ожидаемый_тип = ожидаемый_тип.заменить("?", "")
        }
        
        если (есть_ключ?(данные, ключ) == ложь) {
            если (необязательно == ложь) {
                ошибки.добавить("Отсутствует поле: " + ключ)
            }
        } иначе {
            пусть фактический = тип(данные[ключ])
            если (фактический != ожидаемый_тип) {
                ошибки.добавить("Поле '" + ключ + "': ожидался " + ожидаемый_тип + ", получен " + фактический)
            }
        }
    }
    
    вернуть ошибки
}

функция соответствует?(данные, схема) {
    вернуть длина_json(проверить_схему(данные, схема)) == 0
}
